module sh.sysl.regex

import sh.sysl.regex.c
import sysl.text.{cstring, from_cstring}

// POSIX regular expressions, bound through the C in `c/` beside this file.
//
// **This package is the worked example of binding a library the machine already has.** The other
// bindings in the organisation -- linenoise, monocypher, qcbor -- carry the library's own C, so
// nothing has to be installed to use them. This one carries none: `regcomp`, `regexec`, `regerror`
// and `regfree` are in the C library, POSIX has specified them since 1003.2, and every hosted target
// sysl builds for already links the thing that holds them. So there is no vendored source here, and
// there is no `@link` either -- naming `c` would be naming what the driver passes unasked (`15 §8`).
//
// **What it still needs is a shim, and that is the lesson.** "Already installed" answers where the
// implementation comes from; it answers nothing about whether sysl can reach it. Two things in
// `<regex.h>` are reachable from C and from nothing else, and `c/shim.c` exists for exactly those two
// (`15 §7` sets out the general form):
//
//   - **`regex_t` is caller-allocated and its size is a platform's business** -- 32 bytes on Darwin,
//     64 under glibc. A program can only allocate storage whose size it knows, so the shim allocates
//     it and hands back a pointer, and this side never learns the size at all.
//   - **`regmatch_t` is a layout only the header knows.** The shim copies the two offsets out into
//     plain integers, so the struct never crosses.
//
// The alternative is transcribing those numbers here, which compiles everywhere and is correct on
// whichever machine the author happened to use. Nothing would check it -- sysl's own `sizeof` would
// report what sysl laid out rather than what C did -- and getting it wrong writes past the end of
// the caller's storage.
//
// **A third thing was on that list until `c const` shipped, and `Options` below is what its going
// bought.** `REG_EXTENDED` is a `#define`, so there is no symbol to link; but a macro's *number* is
// something sysl can ask the C compiler for, and `sh.sysl.regex.c` does. Until then the shim chose the
// syntax for everybody, and case-insensitive matching -- one flag -- was simply unreachable.
//
// So the rule this package is here to demonstrate: **a binding to a libc interface is a shim plus a
// `requires`, and no vendoring.** `sysl.hocon` carries the second half -- `<regex.h>` is POSIX
// and not ISO C, and the shim allocates, so the package says `posix` and `heap` rather than letting
// a freestanding build discover both at the link.

// Where a match landed, as byte offsets into the subject.
struct Match
    start: usize
    end: usize

// How a pattern is to be read.
//
// **Extended syntax is not a field here, because it is not a choice.** POSIX basic syntax makes `+`,
// `?`, `|` and `{m,n}` literal characters, which is a 1970s compatibility mode rather than a dialect
// anybody writing a new program wants -- a binding offering it would be offering a way to have `a+b`
// match three characters. Extended is always on, and `Options` is what is left over.
struct Options
    // Match without regard to case.
    icase: bool

    // Treat the subject as lines: `.` and a negated bracket stop at a newline, and `^` and `$` match
    // beside one. Without it a newline is an ordinary character and the anchors mean the two ends of
    // the whole subject.
    newline: bool

    // The `cflags` value these ask for, or'd onto extended syntax. Each name is the header's own,
    // asked for through `c const` rather than written here as a number.
    code(self) -> int
        var flags = c.EXTENDED

        if self.icase then flags |= c.ICASE

        if self.newline then flags |= c.NEWLINE

        flags
    end code
end Options

// What `compile` uses: extended syntax, case-sensitive, and a subject that is one string rather than a
// set of lines.
plain() -> Options = Options(false, false)

// A compiled pattern.
//
// **The handle is storage `c/shim.c` allocated, and this is a `&Regex` with a destructor** -- so
// nothing has to be released by hand and there is no way to forget. A `free` method left the public
// API when that arrived; the pattern is freed when the last reference to it goes.
struct Regex
    handle: *c.Regex

    // Whether the subject matches anywhere, which is the common question.
    matches(&self, s: string) -> bool = self.find(s).is_some()

    // Where the whole match landed, or nothing.
    find(&self, s: string) -> Option[Match]
        val subject = cstring(s)

        var so: i64 = 0
        var eo: i64 = 0

        if c.exec(self.handle, subject.ptr, &so, &eo) == 1 then
            Some(Match(usize(so), usize(eo)))
        else
            None
    end find
end Regex

// `regfree` on the pattern and `free` on the storage it sat in, which `c/shim.c` does together
// because it allocated them together.
impl Drop for Regex
    drop(self) = c.free(self.handle)

// A compiled pattern, or the message the C library gave for why it is not one.
//
// The message shows both directions of the string boundary in one place: `cstring` copies the
// pattern into the NUL-terminated bytes `regcomp` reads, and `from_cstring` copies `regerror`'s
// answer back out. Neither side ever holds a pointer into the other's storage.
compile(pattern: string) -> Result[&Regex, string] = compile_with(pattern, plain())

// The same, reading the pattern as `o` says.
//
//     val ci = compile_with("hello", Options(true, false))?
compile_with(pattern: string, o: Options) -> Result[&Regex, string]
    val re   = c.new()
    val p    = cstring(pattern)
    val code = c.compile(re, p.ptr, o.code())

    if code == 0 then
        Ok(Regex(re))
    else
        var buf: [256]u8

        c.error(re, code, &buf[0], 256)
        c.free(re)
        Err(from_cstring(&buf[0]).unwrap_or("the pattern did not compile"))
end compile_with
